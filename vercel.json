{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "includeFiles": [
          "index.php",
          "dashboard.php",
          "candidature.php",
          "espace-candidat.php",
          "api.php",
          "turso-test.php",
          "assets/**",
          "includes/**",
          "data/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.php" }
  ]
}
