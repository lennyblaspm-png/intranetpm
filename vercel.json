{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "includeFiles": [
          "index.php",
          "dashboard.php",
          "candidature.php",
          "espace-candidat.php",
          "api.php",
          "includes/**",
          "data/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/api/(.*)", "dest": "api/index.php" },
    { "src": "/(.*\\.php)", "dest": "api/index.php" },
    { "src": "/$", "dest": "api/index.php" }
  ]
}
